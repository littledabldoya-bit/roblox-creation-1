local cross=el("Frame","Crosshair",gui,{Position=UDim2.fromScale(.5,.5),AnchorPoint=Vector2.new(.5,.5),Size=UDim2.fromOffset(4,4),BackgroundColor3=C.White,BorderSizePixel=0})
