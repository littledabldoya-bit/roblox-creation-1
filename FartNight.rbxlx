Item class="Folder" referent="RBX00000670"><Properties><string name="Name">FN_WeaponArt</string></Properties></Item><Item class="Folder" referent="RBX00000671"><Properties><string name="Name">FN_Remotes</string></Properties><Item class="RemoteEvent" referent="RBX00000672"><Properties><string name="Name">Shoot</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000673"><Properties><string name="Name">Reload</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000674"><Properties><string name="Name">Sync</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000675"><Properties><string name="Name">RequestSync</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000676"><Properties><string name="Name">Shop</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000677"><Properties><string name="Name">Notice</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000678"><Properties><string name="Name">FX</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000679"><Properties><string name="Name">Storm</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000680"><Properties><string name="Name">Sprint</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000681"><Properties><string name="Name">SelectWeapon</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000682"><Properties><string name="Name">HitConfirm</string></Properties></Item><Item class="RemoteEvent" referent="RBX00000683"><Properties><string name="Name">Slide</string></Properties></Item></Item><Item class="ModuleScript" referent="FN_Economy_Module"><Properties><string name="Name">FN_Economy</string><ProtectedString name="Source"><![CDATA[-- Pure economy operations. All persistence and authorization live on the server.
local Economy = {}

local function integer(value)
    if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return 0 end
    return math.max(0, math.floor(value))
end

function Economy.normalize(value, cosmetics)
    local old = type(value) == "table" and value or {}
    local data = {
        Coins = integer(old.Coins), XP = integer(old.XP),
        KOs = integer(old.KOs), Deaths = integer(old.Deaths),
        Unlocks = {Mint = true}, Equipped = "Mint", EquippedCrown = "None", Receipts = {},
    }
    if type(old.Unlocks) == "table" then
        for id, owned in pairs(old.Unlocks) do
            if owned == true and cosmetics[id] then data.Unlocks[id] = true end
        end
    end
    if type(old.Receipts) == "table" then
        for id, granted in pairs(old.Receipts) do
            if type(id) == "string" and granted == true then data.Receipts[id] = true end
        end
    end
    if type(old.EquippedCrown)=="string" then data.EquippedCrown=old.EquippedCrown end
    if cosmetics[old.Equipped] then data.Equipped = old.Equipped end
    if type(old.LastSaveId)=="string" then data.LastSaveId=old.LastSaveId end
    if type(old.Session) == "table" then data.Session = table.clone(old.Session) end
    return data
end

function Economy.canClaim(data, owner, now)
    local lease = data.Session
    return not lease or lease.Owner == owner or type(lease.Expires) ~= "number" or lease.Expires <= now
end

function Economy.grantReceipt(data, purchaseId, award)
    assert(type(purchaseId) == "string" and #purchaseId > 0, "Invalid receipt ID")
    assert(type(award) == "number" and award > 0 and award % 1 == 0, "Invalid receipt award")
    if data.Receipts[purchaseId] then return false end
    data.Coins += award
    data.Receipts[purchaseId] = true
    return true
end

function Economy.productAward(config, productId)
    if type(productId) ~= "number" or productId <= 0 then return nil end
    local found
    for key, id in pairs(config.Products) do
        if id == productId then
            local amount = config.ProductAwards[key]
            -- Ambiguous or malformed catalogs must never grant the wrong product.
            if found or type(amount) ~= "number" or amount <= 0 or amount % 1 ~= 0 then return nil end
            found = amount
        end
    end
    return found
end

function Economy.canEquipCrown(catalog, owned, id)
    if id=="None" then return true end
    if type(id)~="string" or type(owned)~="table" or owned[id]~=true then return false end
    for _,crown in ipairs(catalog) do
        if crown.Id==id then return true end
    end
    return false
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000684"><Properties><string name="Name">FN_Config</string><ProtectedString name="Source"><![CDATA[-- FART-NIGHT / ReplicatedStorage / FN_Config
-- Replace all 0 IDs with your OWN Roblox Creator Hub monetization IDs.
local Config = {}

Config.GameName = "FART-NIGHT"
Config.Version = "3.3.0"
Config.ArenaRadius = 255
Config.RespawnSeconds = 3
Config.CoinPickupValue = 5
Config.KillCoins = 25
Config.TargetCoins = 5
Config.CoinRespawnSeconds = 16
Config.SpawnShieldSeconds = 6
-- A safe inner spawn circle never touches the looping gas storm.
Config.SafeSpawnRadius = 74
Config.StormPeriod = 240
Config.StormMaxRadius = 275
Config.StormMinRadius = 190
Config.StormCenterWander = 20

Config.Weapons = {
    BeanBlaster = { Display = "BEAN BLASTER", Damage = 12, FireDelay = 0.14, Magazine = 32, Reload = 1.9, Range = 380, Pellets = 1, Spread = 0.012, Color = Color3.fromRGB(70, 255, 119), Automatic = true },
    BurpCannon = { Display = "BURP CANNON", Damage = 9, FireDelay = 0.88, Magazine = 7, Reload = 2.2, Range = 120, Pellets = 8, Spread = 0.095, Color = Color3.fromRGB(244, 222, 69), Automatic = false },
    ToxicTagger = { Display = "TOXIC TAGGER", Damage = 46, FireDelay = 1.10, Magazine = 8, Reload = 2.6, Range = 650, Pellets = 1, Spread = 0.001, Color = Color3.fromRGB(175, 99, 254), Automatic = false },
}
Config.WeaponOrder = {"BeanBlaster", "BurpCannon", "ToxicTagger"}

-- Owned/equipped outfit accent colors; these are the fun unlocks, not stat buffs.
Config.Cosmetics = {
    {Id = "Mint", Name = "MINT CLOUD", Cost = 0, Color = Color3.fromRGB(77, 255, 156)},
    {Id = "Berry", Name = "BERRY BLAST", Cost = 120, Color = Color3.fromRGB(214, 96, 255)},
    {Id = "Bubblegum", Name = "BUBBLEGUM", Cost = 220, Color = Color3.fromRGB(255, 123, 196)},
